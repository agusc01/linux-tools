#!/bin/sh
# linux-tools-managed: agusc01/linux-tools
# Elegir el gestor activo, sin detener servicios ni reescribir credenciales.
set -eu
# Alpine no incluye /sbin en PATH de usuarios normales. Funciona incluso
# antes de recargar las nuevas opciones de la sesión Fish.
PATH="$PATH:/sbin:/usr/sbin:/usr/local/sbin"
export PATH LC_ALL=C
usage() {
    echo 'Uso: lt-wifi status|list|doctor|connections|on|off|connect SSID|disconnect IFACE' >&2
}
action=${1:-}
[ "$#" -gt 0 ] || { usage; exit 2; }
shift
case "$action" in
    status|list|doctor|connections|on|off) [ "$#" -eq 0 ] || { usage; exit 2; } ;;
    connect|disconnect) [ "$#" -eq 1 ] && [ -n "$1" ] || { usage; exit 2; } ;;
    *) usage; exit 2 ;;
esac

wpa_running() {
    if command -v pidof >/dev/null 2>&1 && pidof wpa_supplicant >/dev/null 2>&1; then
        return 0
    fi
    if command -v pgrep >/dev/null 2>&1 && pgrep -x wpa_supplicant >/dev/null 2>&1; then
        return 0
    fi
    return 1
}
nm_running() {
    command -v nmcli >/dev/null 2>&1 &&
        nmcli -t -f RUNNING general 2>/dev/null | grep -qx running
}
wifi_interface() {
    if [ -n "${LT_WIFI_INTERFACE:-}" ]; then
        printf '%s\n' "$LT_WIFI_INTERFACE"
        return
    fi
    command -v iw >/dev/null 2>&1 || {
        echo 'Error: falta iw. Repetí sh install.sh --modules wifi para instalarlo.' >&2
        return 1
    }
    iw dev | awk '$1 == "Interface" { print $2; exit }'
}
wpa_control_available() {
    command -v wpa_cli >/dev/null 2>&1 &&
        [ "$(wpa_cli -i "$interface" ping 2>/dev/null)" = PONG ]
}
need_control() {
    if ! wpa_control_available; then
        echo 'Error: wpa_supplicant está activo, pero wpa_cli no encuentra su socket de control.' >&2
        echo 'No se cambió la conexión. Para administrarla, configurá ctrl_interface en wpa_supplicant y reiniciá el servicio solamente cuando puedas permitir una desconexión.' >&2
        echo 'lt-wifi status y lt-wifi list siguen disponibles sin ese socket.' >&2
        return 1
    fi
}
wpa_scan() {
    file=$(mktemp)
    error_file=$(mktemp)
    trap 'rm -f "$file" "$error_file"' EXIT HUP INT TERM
    if iw dev "$interface" scan > "$file" 2>"$error_file"; then
        :
    elif ! grep -Eiq 'permission denied|operation not permitted' "$error_file"; then
        cat "$error_file" >&2
        return 1
    elif command -v doas >/dev/null 2>&1; then
        doas "$(command -v iw)" dev "$interface" scan > "$file" || {
            echo 'Error: escaneo Wi-Fi fallido.' >&2
            return 1
        }
    elif command -v sudo >/dev/null 2>&1; then
        sudo "$(command -v iw)" dev "$interface" scan > "$file" || return 1
    else
        echo 'Error: el escaneo requiere privilegios. Ejecutá doas iw dev '"$interface"' scan.' >&2
        cat "$error_file" >&2
        return 1
    fi
    awk '/^[[:space:]]*SSID:[[:space:]]*/ {
        sub(/^[[:space:]]*SSID:[[:space:]]*/, "")
        if (length($0)) print
    }' "$file" | sort -u
}
if nm_running; then
    case "$action" in
        status|doctor)
            echo 'Gestor: NetworkManager'
            nmcli -f WIFI general
            nmcli -f DEVICE,TYPE,STATE,CONNECTION device status
            if [ "$action" = doctor ]; then
                echo 'Socket de wpa_supplicant: no necesario; controla NetworkManager.'
            fi ;;
        list) nmcli -f IN-USE,SSID,SECURITY,SIGNAL device wifi list --rescan yes ;;
        connections) nmcli -f NAME,TYPE,DEVICE connection show ;;
        on|off) nmcli radio wifi "$action" ;;
        connect) nmcli --ask device wifi connect "$1" ;;
        disconnect) nmcli device disconnect "$1" ;;
    esac
    exit $?
fi
if ! wpa_running; then
    echo 'Error: no se detectó NetworkManager activo ni wpa_supplicant.' >&2
    echo 'No se iniciaron ni detuvieron servicios automáticamente.' >&2
    exit 1
fi
interface=$(wifi_interface)
[ -n "$interface" ] || {
    echo 'Error: no se detectó una interfaz Wi-Fi (iw dev).' >&2
    exit 1
}
if ! command -v iw >/dev/null 2>&1; then
    echo 'Error: falta iw para consultar el estado Wi-Fi con wpa_supplicant.' >&2
    exit 1
fi
case "$action" in
    status)
        echo "Gestor: wpa_supplicant | Interfaz: $interface"
        if wpa_control_available; then
            wpa_cli -i "$interface" status
        else
            echo 'Control wpa_cli: no disponible (falta ctrl_interface o acceso al socket).'
            iw dev "$interface" link
        fi
        if command -v ip >/dev/null 2>&1; then
            # BusyBox ip no reconoce "-brief"; esta forma es compatible.
            ip addr show dev "$interface" 2>/dev/null || true
        fi ;;
    list)
        echo "Redes visibles en $interface:"
        wpa_scan ;;
    doctor)
        echo "Gestor: wpa_supplicant | Interfaz: $interface"
        if wpa_control_available; then
            echo 'Socket de control: OK (PONG).'
            echo 'Se pueden listar y seleccionar redes previamente configuradas.'
        else
            echo 'Socket de control: NO disponible para este usuario.'
            socket_dir=${LT_WIFI_CTRL_DIR:-/run/wpa_supplicant}
            if [ -S "$socket_dir/$interface" ]; then
                echo "El socket $socket_dir/$interface existe: comprobá permisos y grupo."
            else
                echo "No se encuentra el socket en $socket_dir/$interface."
            fi
            config_file=${LT_WIFI_WPA_CONFIG:-/etc/wpa_supplicant/wpa_supplicant.conf}
            if [ -r "$config_file" ]; then
                if grep -Eq '^[[:space:]]*ctrl_interface[[:space:]]*=' "$config_file"; then
                    echo 'Configuración: ctrl_interface ya está declarado.'
                else
                    echo 'Configuración: no se encuentra ctrl_interface.'
                fi
                if grep -Eq '^[[:space:]]*ctrl_interface_group[[:space:]]*=' "$config_file"; then
                    echo 'Configuración: ctrl_interface_group declarado.'
                else
                    echo 'Configuración: no se encuentra ctrl_interface_group.'
                fi
            else
                echo "Configuración: $config_file no es legible por el usuario actual."
                echo "Para revisar SIN mostrar contraseñas: doas grep -E '^(ctrl_interface|ctrl_interface_group)=' $config_file"
            fi
            echo 'En la configuración de wpa_supplicant, fuera de network={...}, usar:'
            echo '  ctrl_interface=/run/wpa_supplicant'
            echo '  ctrl_interface_group=wheel'
            echo 'El grupo wheel podrá administrar redes: usarlo solo si confiás en sus miembros.'
            echo 'Hacé backup del archivo sensible antes de editarlo. Nunca lo pegues entero en un chat.'
            echo 'Los cambios requieren reiniciar wpa_supplicant en un momento oportuno: puede cortar Internet.'
            echo 'Esta herramienta NO modifica la configuración ni reinicia el servicio.'
        fi ;;
    connections)
        need_control || exit 1
        wpa_cli -i "$interface" list_networks ;;
    connect)
        need_control || exit 1
        # Solo cambiar a redes YA configuradas; nunca filtrar ni imprimir claves.
        id=$(wpa_cli -i "$interface" list_networks |
            awk -F '\t' -v ssid="$1" 'NR > 1 && $2 == ssid {print $1; exit}')
        case "$id" in
            ''|*[!0-9]*) echo 'Error: red no guardada. No se almacenarán contraseñas desde argumentos.' >&2; exit 1 ;;
        esac
        wpa_cli -i "$interface" select_network "$id"
        echo 'Revisá DHCP si cambiaste de red: wpa_supplicant no asigna direcciones IP.' ;;
    disconnect)
        [ "$1" = "$interface" ] || { echo "Error: interfaz esperada: $interface" >&2; exit 2; }
        need_control || exit 1
        wpa_cli -i "$interface" disconnect ;;
    on|off)
        echo 'Error: con wpa_supplicant no se modifica el estado del radio desde esta herramienta para evitar desconexiones accidentales.' >&2
        echo 'NetworkManager sí admite lt-wifi on/off cuando es el gestor activo.' >&2
        exit 1 ;;
esac
