#!/bin/sh
# linux-tools-managed: agusc01/linux-tools
# Energía sin eval ni systemctl; confirmación negativa predeterminada.
set -eu
[ "$#" -eq 0 ] || { echo 'Uso: rofi_power (sin argumentos)' >&2; exit 2; }
command -v rofi >/dev/null 2>&1 || { echo 'Error: falta Rofi.' >&2; exit 1; }
[ -n "${DISPLAY:-}" ] || { echo 'Error: rofi_power necesita sesión X11.' >&2; exit 1; }
theme_dir="${XDG_CONFIG_HOME:-$HOME/.config}/linux-tools/rofi"
theme="$theme_dir/power.rasi"
if [ -f "$theme" ] && [ ! -L "$theme" ]; then
    selected=$(printf '%s\n' 'Bloquear pantalla' 'Suspender equipo' \
        'Apagar equipo' 'Reiniciar equipo' 'Salir de dwm (pendiente)' |
        rofi -dmenu -no-custom -p 'Equipo' -theme "$theme") || exit 0
else
    selected=$(printf '%s\n' 'Bloquear pantalla' 'Suspender equipo' \
        'Apagar equipo' 'Reiniciar equipo' 'Salir de dwm (pendiente)' |
        rofi -dmenu -no-custom -p 'Equipo') || exit 0
fi
case "$selected" in
    'Bloquear pantalla') action=lock ;;
    'Suspender equipo') action=suspend ;;
    'Apagar equipo') action=poweroff ;;
    'Reiniciar equipo') action=reboot ;;
    'Salir de dwm (pendiente)')
        rofi -e 'La salida controlada de dwm requiere un mecanismo de quit en el fork. No se usará pkill.' || :
        exit 0 ;;
    '') exit 0 ;;
    *) echo 'Acción desconocida: sin cambios.' >&2; exit 2 ;;
esac
if [ "$action" = lock ]; then
    command -v slock >/dev/null 2>&1 || {
        rofi -e 'Falta slock; no se bloqueó la sesión.' || :; exit 1;
    }
    slock &
    lock_pid=$!
    sleep 1
    if ! kill -0 "$lock_pid" 2>/dev/null; then
        echo 'Error: slock terminó inesperadamente; no se apaga la pantalla.' >&2
        exit 1
    fi
    command -v xset >/dev/null 2>&1 && xset dpms force off || :
    exit 0
fi
confirm_theme="$theme_dir/confirm.rasi"
if [ -f "$confirm_theme" ] && [ ! -L "$confirm_theme" ]; then
    confirm=$(printf '%s\n' 'Cancelar' 'Confirmar' |
        rofi -dmenu -no-custom -selected-row 0 -p 'Confirmar acción' \
            -mesg "$selected: ¿estás seguro?" -theme "$confirm_theme") || exit 0
else
    confirm=$(printf '%s\n' 'Cancelar' 'Confirmar' |
        rofi -dmenu -no-custom -selected-row 0 -p 'Confirmar acción' \
            -mesg "$selected: ¿estás seguro?") || exit 0
fi
[ "$confirm" = Confirmar ] || exit 0

if [ "$action" = suspend ]; then
    # Suspender solo cuando hay un gestor de sesiones que lo soporte.
    command -v loginctl >/dev/null 2>&1 || {
        rofi -e 'Suspensión no configurada: falta loginctl/elogind.' || :
        exit 1
    }
    # Requiere slock para no despertar la sesión sin protección.
    command -v slock >/dev/null 2>&1 || {
        rofi -e 'No se suspende sin slock disponible para bloquear antes.' || :
        exit 1
    }
    slock &
    lock_pid=$!
    sleep 1
    kill -0 "$lock_pid" 2>/dev/null || {
        echo 'Error: slock falló, no se suspende.' >&2; exit 1;
    }
    exec loginctl suspend
fi

# Para apagar o reiniciar, loginctl/elogind puede pedir autorización de PolicyKit.
# Si no existe, no usamos pkill ni systemctl: requerimos una elevación explícita.
if command -v loginctl >/dev/null 2>&1; then
    exec loginctl "$action"
fi
binary=''
for file in "/sbin/$action" "/usr/sbin/$action" "/bin/$action" "/usr/bin/$action"; do
    if [ -x "$file" ]; then binary=$file; break; fi
done
[ -n "$binary" ] || { rofi -e "No se encontró $action." || :; exit 1; }
if [ "$(id -u)" -eq 0 ]; then
    exec "$binary"
elif command -v pkexec >/dev/null 2>&1; then
    exec pkexec "$binary"
elif [ -t 0 ] && command -v doas >/dev/null 2>&1; then
    exec doas "$binary"
elif [ -t 0 ] && command -v sudo >/dev/null 2>&1; then
    exec sudo "$binary"
else
    rofi -e 'La acción requiere autorización. Usá loginctl/elogind, pkexec o una terminal con doas.' || :
    echo 'No se ejecutó la acción: falta un elevador gráfico seguro.' >&2
    exit 1
fi
